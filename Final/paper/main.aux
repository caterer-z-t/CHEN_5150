\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  \textit  {Steady-state model behavior across KIV-2 repeat number.} (a) Normalized plasma Lp(a) $P_{ss}(n)/P_{ss}(14)$ versus KIV-2 copy number, compared to allele-specific production rates from Rader et al. \citep  {rader1994inverse} (gray squares $\pm $ SEM; $\chi ^2_{(3)} = .34$, $p = 0.951$). (b) ER secretion efficiency $\eta _{ER}(n)$. (c) Assembly efficiency $\eta _a(n)$. (d) Normalized ER apo(a) load $E_{ss}(n)/E_{ss}(14)$ on a log scale. }}{14}{figure.2}\protected@file@percent }
\newlabel{fig:1}{{2}{14}{\textit {Steady-state model behavior across KIV-2 repeat number.} (a) Normalized plasma Lp(a) $P_{ss}(n)/P_{ss}(14)$ versus KIV-2 copy number, compared to allele-specific production rates from Rader et al. \citep {rader1994inverse} (gray squares $\pm $ SEM; $\chi ^2_{(3)} = .34$, $p = 0.951$). (b) ER secretion efficiency $\eta _{ER}(n)$. (c) Assembly efficiency $\eta _a(n)$. (d) Normalized ER apo(a) load $E_{ss}(n)/E_{ss}(14)$ on a log scale}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  \textit  {Bayesian prior-to-posterior for ERAD kinetics and model predictions.} (a) Marginal distributions for $\lambda $ (ERAD per-repeat susceptibility, hr$^{-1}$~repeat$^{-1}$); dashed vertical line indicates prior point estimate; solid vertical line indicates posterior median; shaded band shows posterior 95\% credible interval. (b) Marginal distributions for $k_{fold,0}$ (ER folding rate constant, hr$^{-1}$); same conventions as (a). (c) Joint 2D posterior density for $(\lambda ,\, k_{fold,0})$; star indicates prior point estimate; diamond indicates posterior median. (d) Normalized plasma Lp(a) $P_{ss}(n)/P_{ss}(14)$ versus KIV-2 copy number; dashed line shows prior model; solid line shows posterior median model; shaded bands show posterior 50\% and 95\% credible envelopes; gray points show Rader 1994 production rate data ($\pm $ SEM). (e) ERAD rate $k_{ERAD}(n) = k_e \cdot e^{\lambda n}$ on a log scale; dashed line shows prior, solid line shows posterior median, shaded band shows posterior 95\% credible interval propagated across 500 posterior draws. (f) ER secretion efficiency $\eta _{ER}(n)$ [\%]; same conventions as (e). All posterior results are based on 4 chains $\times $ 2000 NUTS draws ($\hat  {R} < 1.01$), conditioned on isoform-specific production rate data from Rader et al.\citep  {rader1994inverse} at $n = 7, 14, 20, 26$. }}{15}{figure.3}\protected@file@percent }
\newlabel{fig:2}{{3}{15}{\textit {Bayesian prior-to-posterior for ERAD kinetics and model predictions.} (a) Marginal distributions for $\lambda $ (ERAD per-repeat susceptibility, hr$^{-1}$~repeat$^{-1}$); dashed vertical line indicates prior point estimate; solid vertical line indicates posterior median; shaded band shows posterior 95\% credible interval. (b) Marginal distributions for $k_{fold,0}$ (ER folding rate constant, hr$^{-1}$); same conventions as (a). (c) Joint 2D posterior density for $(\lambda ,\, k_{fold,0})$; star indicates prior point estimate; diamond indicates posterior median. (d) Normalized plasma Lp(a) $P_{ss}(n)/P_{ss}(14)$ versus KIV-2 copy number; dashed line shows prior model; solid line shows posterior median model; shaded bands show posterior 50\% and 95\% credible envelopes; gray points show Rader 1994 production rate data ($\pm $ SEM). (e) ERAD rate $k_{ERAD}(n) = k_e \cdot e^{\lambda n}$ on a log scale; dashed line shows prior, solid line shows posterior median, shaded band shows posterior 95\% credible interval propagated across 500 posterior draws. (f) ER secretion efficiency $\eta _{ER}(n)$ [\%]; same conventions as (e). All posterior results are based on 4 chains $\times $ 2000 NUTS draws ($\hat {R} < 1.01$), conditioned on isoform-specific production rate data from Rader et al.\citep {rader1994inverse} at $n = 7, 14, 20, 26$}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textit  {Normalized local sensitivity heatmaps.} Sensitivity coefficients $S(Y; k_i)$ for (a) plasma Lp(a) $P_{ss}$, (b) ER apo(a) load $E_{ss}$, and (c) ER secretion efficiency $\eta _{ER}$, evaluated at posterior median parameters. Warm colors indicate positive sensitivity; cool colors indicate negative sensitivity. KIV-2 copy number on the x-axis; model parameters on the y-axis.}}{16}{figure.4}\protected@file@percent }
\newlabel{fig:3}{{4}{16}{\textit {Normalized local sensitivity heatmaps.} Sensitivity coefficients $S(Y; k_i)$ for (a) plasma Lp(a) $P_{ss}$, (b) ER apo(a) load $E_{ss}$, and (c) ER secretion efficiency $\eta _{ER}$, evaluated at posterior median parameters. Warm colors indicate positive sensitivity; cool colors indicate negative sensitivity. KIV-2 copy number on the x-axis; model parameters on the y-axis}{figure.4}{}}
